# ASMR Tools — contoh konfigurasi environment.
#
# File ini TEMPLATE: jangan isi nilai asli di sini (repo publik).
# Salin isinya ke file env asli yang disimpan DI LUAR repo, mis.:
#   ~/workspace/asmr-service/secrets/asmr-auth.env   (izin 600)
# lalu rujuk file itu dari systemd lewat EnvironmentFile=,
# atau export manual sebelum menjalankan server.

# ── Gerbang login UI (HTTP Basic Auth) ─────────────────────────────
# Aktif hanya bila KEDUA variabel ini terisi. Kosong = login nonaktif
# (cocok untuk dev lokal). Semua halaman + API wajib login bila aktif.
ASMR_AUTH_USER=
# Hash SHA-256 dari password — BUKAN password aslinya.
# Buat hash dengan perintah:
#   printf '%s' 'password-anda' | sha256sum
ASMR_AUTH_PASS_SHA256=

# ── Lokasi data (opsional — ada default di kode) ───────────────────
# Folder pustaka audio elemen (default: folder library/ di repo).
# ASMR_LIBRARY_DIR=/path/ke/library
# Folder data Jobs agar render bisa di-resume (default di kode).
# ASMR_JOBS_DIR=/path/ke/jobs
# File sesi live terakhir (default di kode).
# ASMR_LIVE_SESSION_FILE=/path/ke/live-last-session.json

# ── Lainnya ────────────────────────────────────────────────────────
# URL publik instance ini bila di belakang tunnel/domain sendiri.
# ASMR_PUBLIC_URL=https://asmr.example.com
